{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build)",
      "Bash(npm run visual)",
      "Bash(npm run format:check)",
      "Bash(node tools/*.mjs)",
      "Bash(./node_modules/.bin/biome *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)"
    ],
    "deny": [
      "Bash(npx *)",
      "Read(./.env)",
      "Read(./logs/**)"
    ]
  }
}
