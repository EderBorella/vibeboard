# VibeBoard configuration — reference for every supported environment variable.
# Copy to `.env` and edit, or just export the ones you need in your shell.
#
# NOTE: nothing here is required. Every value below shows VibeBoard's own default.
#
# NO API KEYS BELONG IN THIS FILE. VibeBoard never stores credentials. It reuses
# the logins already held by the CLIs it drives — the Claude Code credentials in
# ~/.claude/ and OpenCode's own auth store — and reads them at runtime only.
#
# VibeBoard loads ./.env automatically at startup. Variables already exported in
# your shell take precedence over anything in this file.

# --- Server ---

# Port for the web UI + API.
VIBEBOARD_PORT=4610

# Interface to bind. Defaults to 127.0.0.1 (this machine only), because VibeBoard
# has NO authentication and its copilot can read and write files in the open
# project. Set 0.0.0.0 to reach the board from other devices on your LAN — only
# do that on a network you trust.
#VIBEBOARD_HOST=0.0.0.0

# Folder scanned for existing VibeBoard projects (and the default parent for new
# ones). Defaults to the parent of the working directory.
#VIBEBOARD_ROOT=/path/to/your/projects

# How much the server logs, as JSON lines: fatal, error, warn, info, debug, trace,
# or silent. `info` logs every request and any error a route throws; `silent` turns
# logging off entirely. An unrecognised value falls back to info rather than
# stopping the server from booting.
VIBEBOARD_LOG_LEVEL=info

# Where those lines go — one file per day, appended, gitignored. The default is a
# `logs/` folder inside VibeBoard's own install, NOT inside your board project.
# Set it to empty to write to stdout instead of a file.
#VIBEBOARD_LOG_DIR=/path/to/logs

# How many daily log files to keep. Older ones are deleted when the server starts.
VIBEBOARD_LOG_KEEP=14

# --- Copilot CLIs ---

# Executables used to drive each backend. Set an absolute path if the CLI is not
# on your PATH. You need at least one of these installed and authenticated.
#VIBEBOARD_CLAUDE_BIN=claude
#VIBEBOARD_OPENCODE_BIN=opencode

# How long to wait for a single copilot turn before giving up (milliseconds).
VIBEBOARD_COPILOT_TIMEOUT_MS=180000

# --- Copilot isolation ---

# VibeBoard runs each CLI against a clean config home, so your personal
# CLAUDE.md / AGENTS.md, plugins and hooks do not leak into the copilot.
# Where that clean config home lives:
#VIBEBOARD_COPILOT_HOME=~/.vibeboard/copilot

# Set to 0 to disable isolation and let the copilot load your personal config.
#VIBEBOARD_COPILOT_ISOLATE=0

# --- OpenCode server ---

# VibeBoard spawns `opencode serve` on an OS-assigned port bound to 127.0.0.1.
# Pin that port instead (0 = let the OS choose):
#VIBEBOARD_OPENCODE_PORT=0

# Or attach to an `opencode serve` you run yourself and skip spawning entirely:
#VIBEBOARD_OPENCODE_URL=http://127.0.0.1:4096

# --- Test-only ---
# VIBEBOARD_SHIM_ARGS is set by the test suite to capture CLI arguments.
# Never set it in normal use.
