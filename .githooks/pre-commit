#!/usr/bin/env bash
#
# VibeBoard pre-commit gate: formatting, all three typechecks, lint, and the full test suite.
# Roughly 45 seconds — 40 of it the 3,786 tests.
#
# Installed by the `prepare` script in package.json (git config core.hooksPath .githooks), so a
# fresh clone gets it from `npm install` rather than from remembering to run something.
#
# EVERY CHECK RUNS AGAINST THE INDEX, NOT THE WORKING TREE. That distinction is the whole design,
# and both halves of getting it wrong were reproduced against this hook before it was rewritten:
#
#   * an untracked file holding one type error blocked a commit that did not contain it — and the
#     only way past was `--no-verify`, which is how a gate stops being a gate;
#   * staged broken content PASSED, because the working tree had already been fixed, so a commit
#     that does not typecheck would have landed with six green ticks above it.
#
# `git checkout-index` rather than `git stash --keep-index`: the stash trick is the usual advice
# and it can lose unstaged work when the pop conflicts. A hook that can eat your edits is worse
# than no hook. This copies OUT of the index and never touches the working tree at all.
#
# Bypass with `git commit --no-verify` when you genuinely need to (a WIP checkpoint, a commit that
# only exists to be amended). That escape hatch is the reason this can afford to be strict — and
# needing it routinely is a bug in this file, not in your workflow.
#
# Deliberately NOT here: `npm run mutate`. Mutation testing is minutes, not seconds, and it answers
# a question ("would anyone notice if this broke") that does not need answering on every commit.

set -uo pipefail
REPO=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO" || exit 1

LOGS=$(mktemp -d) || exit 1
SNAP=""
# The symlink is unlinked by name before the recursive delete. `rm -rf` would not follow it anyway,
# but node_modules is 400 MB of other people's work and the cost of being wrong about that once is
# not worth the two saved characters.
cleanup() {
  rm -rf "$LOGS"
  if [ -n "$SNAP" ]; then
    rm -f "$SNAP/node_modules"
    rm -rf "$SNAP"
  fi
}
trap cleanup EXIT
fail=0

dim() { printf '\033[2m%s\033[0m\n' "$1"; }
ok() { printf '\033[32m✓\033[0m %s\n' "$1"; }
bad() {
  printf '\033[31m✗\033[0m %s\n' "$1"
  fail=1
}

# A commit touching only markdown or images cannot break a typecheck or a test. Skipping those
# keeps card edits and doc commits instant, which is most of what this repo's own board produces.
#
# `D` belongs in the filter: deleting the last importer of a module, or a fixture a test reads, is a
# commit that breaks the build while touching no surviving line. Without it such a commit read as
# "no code staged" and skipped every check — verified by staging a deletion of src/core/money.ts,
# which the old filter waved through and this one blocks.
code_staged=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '\.(ts|tsx|json|jsonc|mjs|js)$' || true)
if [ -z "$code_staged" ]; then
  dim "pre-commit: no code staged, skipping typecheck and tests"
  exit 0
fi

if [ ! -x "$REPO/node_modules/.bin/biome" ] || [ ! -x "$REPO/node_modules/.bin/vitest" ]; then
  printf '\033[31m✗\033[0m dependencies missing — run `npm install`\n'
  exit 1
fi

# ---- the snapshot -----------------------------------------------------------------------------
# 511 files, ~40 ms. node_modules is symlinked rather than copied, which is the only reason this is
# affordable; everything else the checks read is tracked, verified by running the whole suite in
# here (3,786 passed) rather than by assuming it.
SNAP=$(mktemp -d) || exit 1
if ! git checkout-index --all --prefix="$SNAP/" 2>"$LOGS/snap.log"; then
  printf '\033[31m✗\033[0m could not read the staged tree\n'
  cat "$LOGS/snap.log"
  exit 1
fi
ln -s "$REPO/node_modules" "$SNAP/node_modules" || exit 1
cd "$SNAP" || exit 1

# THE SUITE MUST NEVER INHERIT A POINTER TO THE REPOSITORY IT IS BEING RUN AGAINST, and until this
# line it did. `git commit` inside a linked worktree exports an ABSOLUTE `GIT_DIR` into the hook's
# environment; the git tests inherit it, and instead of operating on their own temp fixtures they
# operate on THIS repository. Observed on 2026-08-17, all of it:
#
#   * `.git/config` replaced with a fixture's — `bare = true`, so `git status` in the main checkout
#     answered "this operation must be run in a work tree", and `hooksPath = .nohooks`, which
#     silently disabled this gate for every later commit;
#   * the feature branch moved onto a fixture commit, with two stray branches left behind;
#   * 56 unrelated failures in the same run, because `ensureRepo`'s `git rev-parse
#     --is-inside-work-tree` answers TRUE in every temp directory once `GIT_DIR` is absolute, so
#     `git init` never ran and every scaffold test found no `.git`.
#
# Nothing was lost, but recovery was manual and the disabled hook could have gone unnoticed for days.
#
# AFTER `git checkout-index` AND NOT BEFORE: that command is the one thing here that legitimately
# needs the variables, because reading the staged tree is exactly what they point at. Everything
# below this line runs against `$SNAP` and must not be able to find the real repository at all.
#
# All four, not just `GIT_DIR`: `GIT_INDEX_FILE` and `GIT_WORK_TREE` reach a test the same way, and
# `GIT_COMMON_DIR` is the one a worktree sets that the other three do not imply.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR

VITEST=./node_modules/.bin/vitest

# ---- formatting -------------------------------------------------------------------------------
# Checks every staged file, not only the ones this commit touches: formatting drift anywhere in the
# committed tree is a one-command fix, and leaving it to rot is how a formatter stops being trusted.
# Unstaged drift is none of this commit's business and no longer reaches here.
if npm run format:check --silent >"$LOGS/format.log" 2>&1; then
  ok "format"
else
  bad "format — run \`npm run format\` to fix"
  tail -20 "$LOGS/format.log"
fi

# ---- typechecks (parallel) --------------------------------------------------------------------
# Three independent tsconfigs (src is NodeNext, web is bundler-resolved, test covers both), so
# these have no ordering dependency and cost ~1.2s each. Sequentially that is 4s of the budget.
npm run typecheck --silent >"$LOGS/tsc-src.log" 2>&1 &
p_src=$!
npm run typecheck:web --silent >"$LOGS/tsc-web.log" 2>&1 &
p_web=$!
npm run typecheck:test --silent >"$LOGS/tsc-test.log" 2>&1 &
p_test=$!

wait $p_src && ok "typecheck src" || { bad "typecheck src"; tail -20 "$LOGS/tsc-src.log"; }
wait $p_web && ok "typecheck web" || { bad "typecheck web"; tail -20 "$LOGS/tsc-web.log"; }
wait $p_test && ok "typecheck test" || { bad "typecheck test"; tail -20 "$LOGS/tsc-test.log"; }

# ---- tests ------------------------------------------------------------------------------------
if "$VITEST" run --silent >"$LOGS/test.log" 2>&1; then
  ok "tests"
else
  bad "tests"
  tail -30 "$LOGS/test.log"
fi

# ---- lint --------------------------------------------------------------------------------------
# `npm run lint` is `biome check`, the SAME command CI runs — not `biome lint`. That distinction
# cost a red CI run: `check` also reports assists (import organisation), which neither `biome lint`
# nor `biome format` mentions, so the hook passed 87 findings straight through to the pipeline.
#
# `npm run lint` carries --error-on-warnings as of the commit that reached zero diagnostics, so a
# warning now blocks too. Bare `biome check` exits 0 on warnings, which is how 2 useOptionalChain
# findings sat in src/server/signin.ts for a day with the gate reporting green.
if npm run lint --silent >"$LOGS/lint.log" 2>&1; then
  ok "lint"
else
  bad "lint — most of this is auto-fixable with \`npm run lint:fix\`"
  grep -vE '^\s*$' "$LOGS/lint.log" | head -30
fi

if [ "$fail" -ne 0 ]; then
  printf '\n\033[31mcommit blocked.\033[0m Fix the above, or \033[1mgit commit --no-verify\033[0m to override.\n'
  exit 1
fi
exit 0
