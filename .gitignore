# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local notes / private working files
docs/superpowers/
notes/
scratch/
*.private.md

# Secrets — never commit. (.env.example IS committed: it documents the vars.)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc
.netrc
credentials.json
auth.json
id_rsa*

# Copilot chat transcripts: full AI conversations, per project. Never commit these
# — VibeBoard writes them to <project>/.vibeboard/chat/ (see src/server/chat-store.ts).
.vibeboard/chat/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local state / caches
coverage/
.vite/
*.log

# Server logs, one file per day (see src/server/logging.ts). Debugging output about this machine's
# own runs, naming local paths — never useful to anyone else.
logs/

# Mutation testing output: the HTML report and the incremental cache Stryker reuses between runs.
# Both are regenerated by `npm run mutate` and are specific to this machine's checkout.
reports/
.stryker-tmp/

# test shim scratch
test/fixtures/.shim-args.log

# Storybook's static build — a dev workbench, never deployed.
storybook-static/
