{
  "name": "vibeboard",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first cockpit for a markdown project board, editable by the AI CLI agents it orchestrates.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "mutate": "stryker run",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "npm run typecheck && npm run typecheck:web && npm run typecheck:test",
    "dev": "tsx watch src/server/main.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && cp src/server/copilot-system-prompt.md dist/server/copilot-system-prompt.md && vite build --config web/vite.config.ts",
    "start": "node dist/server/main.js"
  },
  "keywords": [
    "kanban",
    "markdown",
    "local-first",
    "ai-agents",
    "self-hosted"
  ],
  "author": "Eder Borella",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EderBorella/vibeboard.git"
  },
  "homepage": "https://github.com/EderBorella/vibeboard#readme",
  "bugs": {
    "url": "https://github.com/EderBorella/vibeboard/issues"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.10.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.1",
    "typescript": "~5.5",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=20.12"
  }
}
