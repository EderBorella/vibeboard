{
  "name": "vibeboard",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first cockpit for a markdown project board, editable by the AI CLI agents it orchestrates.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:visual": "tsc --noEmit -p tsconfig.visual.json",
    "lint": "biome check --error-on-warnings",
    "check:citations": "node tools/check-citations.mjs",
    "check:type-scale": "node tools/check-type-scale.mjs",
    "check:radius-scale": "node tools/check-radius-scale.mjs",
    "check:class-budget": "node tools/check-class-budget.mjs",
    "check:shape-coverage": "node tools/check-shape-coverage.mjs",
    "check:name-resolution": "node tools/check-name-resolution.mjs",
    "check:state-tones": "node tools/check-state-tones.mjs",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:layers": "node tools/check-layers.mjs",
    "check:split": "node tools/check-split.mjs",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "mutate": "stryker run",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "npm run typecheck && npm run typecheck:web && npm run typecheck:test && npm run typecheck:visual && npm run check:citations && npm run check:type-scale && npm run check:radius-scale && npm run check:class-budget && npm run check:shape-coverage && npm run check:name-resolution && npm run check:state-tones && npm run check:tokens && npm run check:layers",
    "dev": "tsx watch src/server/main.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && npm run typecheck:web && cp src/server/copilot-system-prompt.md dist/server/copilot-system-prompt.md && vite build --config web/vite.config.ts",
    "start": "node dist/server/main.js",
    "visual": "node visual/run.mjs",
    "visual:record": "VB_VISUAL_RECORD=1 node visual/run.mjs --grep \"record the baseline\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "box:build": "docker build -f tools/docker/Dockerfile.agent -t vibeboard-agent:latest ."
  },
  "keywords": [
    "kanban",
    "markdown",
    "local-first",
    "ai-agents",
    "self-hosted"
  ],
  "author": "Eder Borella",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EderBorella/vibeboard.git"
  },
  "homepage": "https://github.com/EderBorella/vibeboard#readme",
  "bugs": {
    "url": "https://github.com/EderBorella/vibeboard/issues"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.10.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.29.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "10.5.10",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "storybook": "10.5.10",
    "tsx": "^4.23.1",
    "typescript": "~5.5",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=20.12"
  }
}
